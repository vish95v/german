PORT=4000
# Admin sign-in. Used only on the server. The browser never sends the Gemini key.
ADMIN_EMAIL=admin@questiondesk.com
ADMIN_PASSWORD=admin123
# Google AI Studio key (AIza...) or an OpenRouter key (sk-or-...) used for Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/questiondesk?retryWrites=true&w=majority
